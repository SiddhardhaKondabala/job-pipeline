# job-pipeline environment — copy to .env (bootstrap.sh generates it for you).
#
# Paths may be relative to this hub directory or absolute. bootstrap.sh resolves
# them to absolute paths when it writes .env. It prefers a submodule inside the
# hub (./career-ops, ./linkedin-bot) and falls back to a sibling clone.

# The two repos (defaults assume sibling clones next to job-pipeline/).
CAREER_OPS_DIR="../career-ops"
LINKEDIN_BOT_DIR="../LinkedIn-AI-Job-Applier-Ultimate"

# Personal data root — OUTSIDE both git repos. Holds the queue and results.
CAREER_OPS_ROOT="../career-data"
CAREER_OPS_INTEGRATION_DIR="../career-data/data/integrations"

# Bridge file names (written under CAREER_OPS_INTEGRATION_DIR).
LINKEDIN_APPROVED_QUEUE="linkedin-approved.json"
LINKEDIN_RESULTS="linkedin-results.jsonl"
